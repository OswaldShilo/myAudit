{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-localhost",
  "description": "Allow the Go-served UI at localhost:7788 to use Tauri plugins",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:7788", "http://127.0.0.1:7788"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default"
  ]
}
